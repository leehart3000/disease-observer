# Copy to .env.local and fill in real values. Never commit .env.local.

# Disable Next.js telemetry (also used in CI and on Vercel)
NEXT_TELEMETRY_DISABLED=1

# Postgres with PostGIS. The app uses DATABASE_URL (pooled in production).
# Migrations and the seed script use DATABASE_URL_UNPOOLED (direct).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@HOST:5432/DATABASE
